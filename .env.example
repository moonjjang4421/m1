OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Firebase service-account JSON itself (recommended on Render), or a local key path
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Set true only for local demo/testing without Firebase credentials
USE_MEMORY_DB=false

